rules_version = '2';

// Applied via `firebase deploy --only firestore:rules`. Authorization model:
// every family member's Firebase Auth uid is listed in
// /families/{familyId}.memberUids, and every read/write to that family's data
// checks membership against it -- this is what makes the shared space secure
// without a custom backend.
//
// Joining: a family the caller isn't a member of yet is only visible/joinable
// if their *verified* Google account email (request.auth.token.email, from
// the Firebase Auth ID token) is on that family's `invitedEmails` list, set
// by whoever created the family. This also doubles as how a spouse's client
// discovers the family to join in the first place -- querying
// `families.where('invitedEmails', arrayContains: myEmail)` only returns
// documents this rule already allows them to read, so no separate lookup
// mechanism is needed.
//
// Rules on /families/{familyId} itself read straight off `resource.data` --
// that's already the exact document being evaluated (including per-document
// for a `list` query), so no self-referential get() is needed there. The
// nested /members and /events collections are the ones that actually need
// get() to look up their *parent* family doc.
service cloud.firestore {
  match /databases/{database}/documents {
    function isFamilyMember(familyId) {
      return request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.memberUids;
    }

    // The signed-in account's email, lower-cased -- invite records are keyed
    // by it.
    function myEmail() {
      return request.auth.token.email.lower();
    }

    // Whether there's an invite record for this account into [familyId].
    function invitedTo(familyId) {
      return request.auth != null &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/invites/$(myEmail())) &&
        get(/databases/$(database)/documents/invites/$(myEmail())).data.familyId == familyId;
    }

    // One invite per email, readable only by that email's account. The app
    // reads it directly to find the family it was invited to; searching all
    // families for one listing the email is refused for non-members.
    match /invites/{email} {
      allow get: if request.auth != null && request.auth.token.email != null &&
        myEmail() == email;
      allow create, update: if isFamilyMember(request.resource.data.familyId);
      allow delete: if request.auth != null &&
        ((request.auth.token.email != null && myEmail() == email) ||
         isFamilyMember(resource.data.familyId));
    }

    match /families/{familyId} {
      allow read: if request.auth != null &&
        (request.auth.uid in resource.data.memberUids ||
         request.auth.token.email in resource.data.invitedEmails ||
         invitedTo(familyId));

      // Anonymous accounts (the app's dev-mode sign-in, kDevSignIn) have no
      // email, so they may create a family of one with no invites -- which
      // nobody else can ever join, since joining needs a verified email.
      allow create: if request.auth != null &&
        request.resource.data.memberUids == [request.auth.uid] &&
        (
          (request.auth.token.firebase.sign_in_provider == 'anonymous' &&
           request.resource.data.invitedEmails.size() == 0) ||
          request.auth.token.email in request.resource.data.invitedEmails
        );

      // Existing members can update anything. A non-member may only append
      // their own uid to memberUids (accepting an invite) -- nothing else
      // may change in that case.
      allow update: if request.auth != null &&
        (
          request.auth.uid in resource.data.memberUids ||
          (
            (request.auth.token.email in resource.data.invitedEmails ||
             invitedTo(familyId)) &&
            !(request.auth.uid in resource.data.memberUids) &&
            request.resource.data.memberUids.hasAll(resource.data.memberUids) &&
             request.auth.uid in request.resource.data.memberUids &&
             request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1 &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          )
        );

      allow delete: if request.auth != null && request.auth.uid in resource.data.memberUids;

      match /members/{uid} {
        allow read: if isFamilyMember(familyId);
        allow write: if isFamilyMember(familyId) && request.auth.uid == uid;
      }

      // Shared family data (events, shopping list, grocery history,
      // chores, vault notes, bills, meal plans, and whatever comes next):
      // any member may read and write any of it. /members and /status are
      // excluded because they have their own stricter rules below and
      // above -- you may only write your own entry there.
      match /{collection}/{docId} {
        allow read, write: if isFamilyMember(familyId) &&
          !(collection in ['members', 'status']);
      }

      // Same shape as /members/{uid}: everyone in the family can see
      // everyone's status, but you can only set your own.
      match /status/{uid} {
        allow read: if isFamilyMember(familyId);
        allow write: if isFamilyMember(familyId) && request.auth.uid == uid;
      }
    }
  }
}

rules_version = '2';

// Applied via `firebase deploy --only firestore:rules` once the Firebase
// project exists (Milestone 2). Authorization model: every family member's
// Firebase Auth uid is listed in /families/{familyId}.memberUids, and every
// read/write to that family's data checks membership against it -- this is
// what makes the shared space secure without a custom backend.
service cloud.firestore {
  match /databases/{database}/documents {
    function isFamilyMember(familyId) {
      return request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.memberUids;
    }

    match /families/{familyId} {
      allow read: if isFamilyMember(familyId);
      // Creation is allowed for any signed-in user (they become the first
      // member); membership changes/joins are handled by a validated update,
      // not opened up to arbitrary writes.
      allow create: if request.auth != null &&
        request.resource.data.memberUids == [request.auth.uid];
      allow update, delete: if isFamilyMember(familyId);

      match /members/{uid} {
        allow read: if isFamilyMember(familyId);
        allow write: if isFamilyMember(familyId) && request.auth.uid == uid;
      }

      match /events/{eventId} {
        allow read, write: if isFamilyMember(familyId);
      }
    }
  }
}
